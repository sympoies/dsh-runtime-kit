{
  "name": "@sympoies/dsh-runtime-kit",
  "version": "0.0.0",
  "description": "Out-of-tree DeepSeek Harness runtime policy, skills, and workflow bundle for Sympoies agents",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-runtime-kit": "./bin/dsh-runtime-kit.js",
    "dsh-runtime-kit-launch": "./bin/dsh-runtime-kit-launch.js",
    "dsh-runtime-kit-check-parity": "./scripts/check-rule-parity-source.mjs",
    "dsh-runtime-kit-manage-dsh-patch": "./scripts/manage-dsh-patch.mjs",
    "dsh-runtime-kit-manage-dsh-tui-patch": "./scripts/manage-dsh-tui-patch.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./agent-console-profile": "./src/compat/agent-console.js",
    "./governed-commit": "./src/governed-commit/index.js",
    "./composition": "./src/composition/index.js",
    "./manager": "./src/manager/index.js",
    "./runtime-health": "./src/health/index.js",
    "./authoritative-acceptance": "./src/authoritative-acceptance/index.js",
    "./workspace-lease": "./src/workspace-lease/index.js",
    "./artifacts": "./src/artifacts/index.js",
    "./check-rule-parity-source": "./scripts/check-rule-parity-source.mjs",
    "./policy/rule-parity.yaml": "./policy/rule-parity.yaml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bin",
    "policy.js",
    "src",
    "agent-docs",
    "agents",
    "cordis.patch.yml",
    "compatibility",
    "policy",
    "patches",
    "scripts/check-rule-parity-source.mjs",
    "docs",
    "scripts",
    "test/smoke.mjs",
    "test/authoritative-acceptance-smoke.mjs",
    "test/fixtures/authoritative-acceptance-canary",
    "test/workspace-lease-smoke.mjs",
    "test/workspace-lease-native-smoke.mjs",
    "test/operations-smoke.mjs",
    "skills",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2 || 0.1.2-alpha.4 || 0.1.2-rc.1"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "chokidar": "5.0.0",
    "js-yaml": "4.1.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "bundledDependencies": [
    "@standard-schema/spec",
    "chokidar",
    "js-yaml",
    "yaml",
    "zod"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:composition-contracts": "node --test test/composition-contracts.test.mjs",
    "test:admission-isolation": "node --test test/admission-isolation.test.mjs",
    "test:lifecycle-contracts": "node --test test/lifecycle-contracts.test.mjs",
    "test:control-boundary-contracts": "node --test test/control-boundary-contracts.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:agent-docs-catalog": "node test/agent-docs-catalog-smoke.mjs",
    "test:authoritative-acceptance-smoke": "node test/authoritative-acceptance-smoke.mjs",
    "test:workspace-lease-smoke": "node test/workspace-lease-smoke.mjs",
    "test:workspace-lease-native-smoke": "node test/workspace-lease-native-smoke.mjs",
    "test:operations-smoke": "node test/operations-smoke.mjs",
    "check:compatibility": "node scripts/check-dsh-compatibility.mjs",
    "dsh-patch": "node scripts/manage-dsh-patch.mjs",
    "dsh-tui-patch": "node scripts/manage-dsh-tui-patch.mjs",
    "pack:compatibility-peers": "node scripts/pack-dsh-compatibility-peers.mjs",
    "stage:compatibility-peers": "node scripts/stage-dsh-compatibility-peers.mjs",
    "acceptance": "node scripts/run-acceptance.mjs",
    "benchmark:policy": "node --expose-gc scripts/benchmark-policy.mjs",
    "benchmark:policy:real": "node scripts/benchmark-policy-real.mjs",
    "verify:policy-source": "node scripts/verify-policy-parity.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test:main-agent-e2e": "node test/main-agent-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sympoies/dsh-runtime-kit.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "lifecycle": "./compatibility/profile-lifecycle.json"
  }
}
