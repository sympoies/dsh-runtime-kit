    "code-review-specialists"
  ],
  "required_services": [
    "userQuestions",
    "mainAgentOrchestration"
  ],
  "default_route": {
    "provider": "codex-proxy",
    "model": "gpt-5.6-sol",
    "reasoning_effort": "high"
